# Скопируй в .env и заполни. Файл .env в git НЕ коммитится.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=            # ОБЯЗАТЕЛЬНО: токен от @BotFather
TELEGRAM_ADMIN_IDS=           # csv tg_id админов, напр. 12345,67890

# --- Платежи ---
CRYPTOBOT_TOKEN=              # токен CryptoPay (@CryptoBot); пусто -> USDT выключен
SUB_PRICE_USDT=20
SUB_PRICE_STARS=1000
SUB_DAYS=30

# --- Режим сигналов: auto = алерт сразу (без подтверждения), semiauto = кандидаты /confirm-/reject ---
SIGNAL_MODE=auto

# --- Канал для постинга сигналов (@username или -100... id; пусто = не постить) ---
SIGNALS_CHANNEL=

# --- Биржа / данные ---
EXCHANGE_ID=bybit
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT
TIMEFRAMES=15m,1h
POLL_INTERVAL_SEC=60

# --- Риск ---
DEFAULT_RISK_PCT=1.0
MAX_LEVERAGE=20
FREE_SIGNALS_PER_WEEK=3

# --- Инфраструктура ---
ENV=dev
LOG_LEVEL=INFO
DB_PATH=data/signals.db

# --- V2: шифрование API-ключей юзеров ---
# сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
