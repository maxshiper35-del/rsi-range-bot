<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Вторая копия бэкапов журнала с прод-сервера (Hetzner) на мак — деталь в pull_backup_mac.sh.
  Установка:  cp deploy/com.rsirange.backup-pull.plist ~/Library/LaunchAgents/ &&
              launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.rsirange.backup-pull.plist
  Расписание: 09:30 локального времени (мак обычно уже не спит) + при загрузке.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rsirange.backup-pull</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/mac/bot ctypto/deploy/pull_backup_mac.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
